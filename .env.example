# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
WEB_ORIGIN=http://localhost:5173
# The server package starts from apps/server; the production PWA is a sibling.
WEB_DIST_DIR=../web/dist
PUBLIC_APP_URL=http://localhost:5173
LOG_LEVEL=info

# PostgreSQL (single source of truth and pg-boss queue). Required: set it only
# in an untracked local .env or your deployment secret store.
DATABASE_URL=
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# Authentication and sessions
# Generate at least 32 random bytes for production. Keep this file value blank;
# a real secret belongs only in your untracked .env or deployment secret store.
SESSION_SECRET=
SESSION_TTL_SECONDS=2592000
# Required only until the unique initial Owner is created; use a separate 32+ byte value.
SETUP_TOKEN=
PASSWORD_RESET_TTL_SECONDS=3600
# Applies to a newly bound email address or phone number. It is independent
# from PASSWORD_RESET_TTL_SECONDS so recovery policy does not shorten normal
# contact verification unexpectedly.
CREDENTIAL_VERIFICATION_TTL_SECONDS=86400

# Object storage (required in production for evidence files and exports)
S3_ENDPOINT=
# Exact origin used by browser pre-signed PUT URLs. This can differ from the
# SDK endpoint for virtual-hosted buckets; it is required in production so CSP
# permits only the intended private-storage origin.
S3_BROWSER_ORIGIN=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
SIGNED_URL_TTL_SECONDS=900
ATTACHMENT_MAX_BYTES=104857600

# Optional automatic email/SMS delivery. Leave blank for the default
# Owner/manager manual one-time invitation-link flow; self-service contact
# verification and self-service password reset still need a real provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Set to twilio only after all three TWILIO_* values are configured. The
# application deliberately does not emulate successful SMS delivery.
SMS_PROVIDER=disabled
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Browser push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# AI provider (core business remains available when disabled or unavailable)
AI_ENABLED=true
ZHIPU_API_KEY=
ZHIPU_API_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4.7-flash
AI_REQUEST_TIMEOUT_MS=60000
AI_MAX_RETRIES=2
# Required to encrypt organization-owned AI keys. Use the exact same 32+ byte
# secret for the API service and the background worker; never rotate it without
# a controlled key re-entry plan.
AI_CONFIG_ENCRYPTION_KEY=

# Optional future multi-instance event bus/cache
REDIS_URL=

# No demo accounts or business records are shipped. Create the first Owner
# through /setup after migrations have completed.
