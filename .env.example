# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
WEB_ORIGIN=http://localhost:5173
WEB_DIST_DIR=apps/web/dist
PUBLIC_APP_URL=http://localhost:5173
LOG_LEVEL=info

# PostgreSQL (single source of truth and pg-boss queue)
DATABASE_URL=postgresql://workbench:workbench@localhost:5432/workbench
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# Authentication and sessions
# Generate at least 32 random bytes for production; never reuse the example value.
SESSION_SECRET=replace-with-at-least-32-random-bytes
SESSION_TTL_SECONDS=2592000
# Required only until the unique initial Owner is created; use 32+ random bytes.
SETUP_TOKEN=replace-with-at-least-32-random-bytes
PASSWORD_RESET_TTL_SECONDS=3600
EMAIL_VERIFICATION_TTL_SECONDS=86400
OWNER_2FA_REQUIRED=false

# Object storage (required in production for evidence files and exports)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
SIGNED_URL_TTL_SECONDS=900
ATTACHMENT_MAX_BYTES=20971520

# Email and SMS providers
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER=

# Browser push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# AI provider (core business remains available when disabled or unavailable)
AI_ENABLED=true
ZHIPU_API_KEY=
ZHIPU_API_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-5.3-flash
AI_REQUEST_TIMEOUT_MS=60000
AI_MAX_RETRIES=3

# Optional future multi-instance event bus/cache
REDIS_URL=

# Development seed only
SEED_OWNER_EMAIL=owner@example.test
SEED_OWNER_PASSWORD=ChangeMe-OnlyForLocalDev-123!
SEED_TIMEZONE=Asia/Shanghai
