{
  "name": "@workbench/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup src/index.ts --format esm --sourcemap --clean",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1123.0",
    "@fontsource/noto-sans-sc": "5.3.0",
    "@workbench/db": "workspace:*",
    "@workbench/shared": "workspace:*",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "exceljs": "4.4.0",
    "pg-boss": "12.29.0",
    "pdfkit": "0.17.2",
    "pino": "10.3.1",
    "web-push": "3.6.7",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "26.4.0",
    "@types/pdfkit": "0.17.6",
    "@types/web-push": "3.6.4",
    "tsup": "8.5.1",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
