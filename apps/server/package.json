{
  "name": "@workbench/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup src/index.ts --format esm --sourcemap --clean",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1123.0",
    "@aws-sdk/s3-request-presigner": "3.1123.0",
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/csrf-protection": "8.0.1",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.3",
    "@fastify/websocket": "11.3.0",
    "@workbench/db": "workspace:*",
    "@workbench/shared": "workspace:*",
    "argon2": "0.45.1",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.1",
    "pino": "10.3.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "tsx": "4.23.13",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
