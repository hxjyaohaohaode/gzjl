  },
  "dependencies": {
    "@tanstack/react-query": "5.102.8",
    "@workbench/shared": "workspace:*",
    "@workbench/ui": "workspace:*",
    "@xyflow/react": "12.11.5",
    "echarts": "6.1.0",
    "lucide-react": "1.38.0",
    "motion": "13.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.87.0",
    "react-router-dom": "7.18.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
